# Server
PORT=5000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hms

# Auth
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=12h

# CORS: comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173

# Frontend base URL (used in password-reset links)
APP_URL=http://localhost:5173

# Email (optional). Leave blank to disable email sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Hotel Management System <no-reply@example.com>"

# Business defaults (seed)
BUSINESS_NAME=My Hotel
CURRENCY=NGN
CURRENCY_SYMBOL=NGN
